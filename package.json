    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.8.0",
    "react": "19.2.8",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
